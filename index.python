class SistemaEspecialistaOficina:
    """
    Sistema especialista para realizar uma triagem inicial
    de possíveis problemas em veículos.

    O programa faz perguntas, analisa as respostas e apresenta
    possíveis problemas e recomendações.
    """

    #Gabriel começa aqui 

    def __init__(self):
        # Aqui ficam as respostas do motorista.
        # E como uma ficha que vamos preenchendo.
        # Ele basicamente armazena a resposta do usuario.
        self.fatos = {}

        # Aqui guardamos o caminho que o sistema percorreu.
        # Ele consegue explicar como chegou ao resultado.
        #E basicamente as regras que foram ativadas.
        self.raciocinio_log = []

        # Aqui ficam os diagnósticos encontrados.
        # Pode aparecer mais de um problema na mesma análise.
        self.diagnosticos = []

    # ---------------------------------------------------------
    # PARTE 1 - FUNÇÕES PARA GUARDAR O RACIOCÍNIO
    # ---------------------------------------------------------

    def registrar_passo(self, regra_id, descricao):
        # Cada vez que uma regra for utilizada,
        # guardamos uma anotação no histórico.
        self.raciocinio_log.append(f"[{regra_id}] {descricao}")

    def registrar_diagnostico(
        self, regra_identificacao, regra_recomendacao,
        fatos_usados, descricao, recomendacao
    ):
        # Primeiro mostramos quais respostas fizeram
        # a regra ser ativada.
        self.registrar_passo(
            regra_identificacao,
            f"Fatos identificados: {fatos_usados}."
        )

        # Depois registramos a orientação relacionada ao problema.
        self.registrar_passo(
            regra_recomendacao,
            f"Orientação: {recomendacao}"
        )

        # Por último, guardamos o diagnóstico para mostrar na tela.
        self.diagnosticos.append(
            f"{descricao}\nRecomendação: {recomendacao}"
        )

    # ---------------------------------------------------------
    # PARTE 2 - VALIDAR AS RESPOSTAS DO USUÁRIO
    # ---------------------------------------------------------

    def validar_resposta(self, pergunta):

        # O while mantém a pergunta na tela até receber S ou N.
        while True:

            resposta = input(pergunta).strip().lower()

            if resposta == "s":
                return True  # S significa Sim.

            elif resposta == "n":
                return False  # N significa Não.

            else:
                # Se a pessoa apertar Enter ou digitar outra coisa,
                # explicamos o erro e perguntamos novamente.
                print("\n[!] Resposta inválida. Digite apenas S ou N.")

    # ---------------------------------------------------------
    # PARTE 3 - APRESENTAÇÃO E COLETA DOS SINTOMAS
    # ---------------------------------------------------------

    def exibir_cabecalho(self):

        print("\n" + "=" * 58)
        print("                 SISTEMA ESPECIALISTA")
        print("                      AUTO OFICINA")
        print("=" * 58)
        print("       Diagnóstico inicial de possíveis problemas")
        print("-" * 58)
        print("Responda às perguntas utilizando S (Sim) ou N (Não).")
        print("-" * 58)

    def coletar_sintomas(self):

        # Primeiro mostramos o nome do sistema e as instruções.
        self.exibir_cabecalho()

        # PRIMEIRA PERGUNTA:
        # Ela divide a análise em dois caminhos.
        self.fatos["motor_liga"] = self.validar_resposta(
            "\nO motor do carro consegue ligar? (s/n): "
        )

        if not self.fatos["motor_liga"]:

            # Se o motor não liga, investigamos a parte elétrica
            # e o sistema de partida.
            self.fatos["luzes_paineis"] = self.validar_resposta(
                "As luzes do painel e os faróis acendem? (s/n): "
            )

            self.fatos["barulho_tec_tec"] = self.validar_resposta(
                "Ouve um barulho rápido de 'tec-tec' ao tentar ligar? (s/n): "
            )

        else:

            # Se o motor liga, podemos investigar os outros sistemas.
            # O dicionário relaciona o nome do fato com a pergunta.
            perguntas = {

                "barulho_freio": "Ouve chiado ou rangido ao pisar no freio? (s/n): ",

                "luz_injecao": "A luz de injeção está acesa no painel? (s/n): ",

                "superaquecimento": "A temperatura do motor está muito alta? (s/n): ",

                "falha_aceleracao": "O carro engasga ou perde força ao acelerar? (s/n): ",

                "barulho_suspensao": "Ouve batidas ou estalos ao passar por buracos? (s/n): ",

                "ar_condicionado_falha": "O ar-condicionado não gela ou apresenta cheiro estranho? (s/n): ",

                "luz_bateria": "A luz da bateria está acesa com o motor ligado? (s/n): "
            }

            # Percorremos as perguntas sem precisar escrever
            # o mesmo comando várias vezes.
            for nome_fato, pergunta in perguntas.items():

                self.fatos[nome_fato] = self.validar_resposta(pergunta)

                #--- Gabriel para de falar aqui ---

    # ---------------------------------------------------------
    # PARTE 4 - MOTOR DE INFERÊNCIA E BASE DE REGRAS
    # ---------------------------------------------------------
    
    #Matheus começa a explicação aqui
    def motor_inferencia(self):

        """
        Aqui acontece a parte principal do sistema especialista.

        O programa analisa os fatos coletados e verifica quais regras
        combinam com as respostas.

        Esse processo é um exemplo de encadeamento para frente:
        começamos com os fatos e usamos as regras para chegar
        a possíveis conclusões.
        """

        # Guardamos quantos diagnósticos existiam antes da análise.
        quantidade_inicial = len(self.diagnosticos)

        # CAMINHO A: O MOTOR NÃO CONSEGUE LIGAR.

        if not self.fatos["motor_liga"]:

            # R01 e R02 - Painel apagado: possível problema elétrico.
            if not self.fatos["luzes_paineis"]:

                self.registrar_diagnostico(
                    "R01", "R02",
                    "motor não liga; painel e faróis não acendem",
                    "O veículo não liga e o painel está apagado. "
                    "Pode existir um problema na alimentação elétrica.",
                    "Verificar a bateria, os cabos e as conexões elétricas."
                )

            # R03 e R04 - Painel aceso e barulho de tec-tec.
            elif self.fatos["barulho_tec_tec"]:

                self.registrar_diagnostico(
                    "R03", "R04",
                    "motor não liga; painel acende; existe barulho de tec-tec",
                    "O veículo apresenta dificuldade no momento da partida.",
                    "Testar a carga da bateria e verificar o motor de partida."
                )

            # R05 e R06 - Painel aceso, mas sem o barulho informado.
            else:

                self.registrar_diagnostico(
                    "R05", "R06",
                    "motor não liga; painel acende; não existe barulho de tec-tec",
                    "O veículo não apresenta sinal sonoro ao tentar dar partida.",
                    "Verificar o circuito de ignição, os fusíveis e o motor de partida."
                )

        # CAMINHO B: O MOTOR CONSEGUE LIGAR.

        else:

            # R07 e R08 - Possível problema no sistema de freios.
            if self.fatos["barulho_freio"]:

                self.registrar_diagnostico(
                    "R07", "R08",
                    "motor liga; existe chiado ou rangido ao frear",
                    "Foram identificados ruídos durante a frenagem.",
                    "Solicitar uma inspeção das pastilhas e dos discos de freio."
                )

                #--- Matheus termina aqui ---

            # R09 e R10 - Temperatura do motor muito alta.

            #Joao inicia aqui 
            if self.fatos["superaquecimento"]:

                self.registrar_diagnostico(
                    "R09", "R10",
                    "motor liga; temperatura está muito alta",
                    "O motor apresenta sinais de superaquecimento.",
                    "Desligar o veículo em segurança e procurar assistência. "
                    "Nunca abrir o reservatório com o motor quente."
                )

            # R11 e R12 - Luz de injeção junto com perda de força.
            if self.fatos["luz_injecao"] and self.fatos["falha_aceleracao"]:

                self.registrar_diagnostico(
                    "R11", "R12",
                    "luz de injeção acesa; carro perde força ou engasga",
                    "Existe um alerta de injeção acompanhado de perda de desempenho.",
                    "Realizar uma leitura dos códigos com scanner automotivo."
                )

            # R13 e R14 - Luz de injeção, mas sem perda de força.
            elif self.fatos["luz_injecao"]:

                self.registrar_diagnostico(
                    "R13", "R14",
                    "luz de injeção acesa; não há perda de força relatada",
                    "A luz de injeção está acesa, mesmo sem perda aparente de força.",
                    "Verificar os códigos de falha com um scanner automotivo."
                )

            # R15 e R16 - Ruídos na suspensão.
            if self.fatos["barulho_suspensao"]:

                self.registrar_diagnostico(
                    "R15", "R16",
                    "motor liga; existem batidas ou estalos ao passar por buracos",
                    "Foram identificados ruídos que podem estar ligados à suspensão.",
                    "Inspecionar amortecedores, buchas, pivôs e demais componentes."
                )

            # R17 e R18 - Ar-condicionado com funcionamento irregular.
            if self.fatos["ar_condicionado_falha"]:

                self.registrar_diagnostico(
                    "R17", "R18",
                    "motor liga; ar-condicionado não gela ou apresenta cheiro estranho",
                    "O sistema de ar-condicionado apresenta funcionamento irregular.",
                    "Verificar o filtro de cabine, possíveis vazamentos e o compressor."
                )

            # R19 e R20 - Luz da bateria acesa com o motor funcionando.
            if self.fatos["luz_bateria"]:

                self.registrar_diagnostico(
                    "R19", "R20",
                    "motor liga; luz da bateria permanece acesa no painel",
                    "A luz da bateria está acesa com o motor em funcionamento.",
                    "Verificar o alternador, a correia e o sistema de carga."
                )

        # R21 - Nenhuma das condições anteriores foi encontrada.
        # Essa regra só entra se nenhum diagnóstico novo foi registrado.
        if len(self.diagnosticos) == quantidade_inicial:

            self.registrar_passo(
                "R21",
                "Nenhum dos sintomas investigados foi identificado."
            )

            self.diagnosticos.append(
                "Nenhuma anormalidade foi identificada durante esta triagem.\n"
                "Recomendação: manter as revisões e a manutenção preventiva."
            )

    # ---------------------------------------------------------
    # PARTE 5 - MOSTRAR O RESULTADO E EXPLICAR O RACIOCÍNIO
    # ---------------------------------------------------------

    def exibir_resultado(self):

        print("\n" + "=" * 58)
        print("                  RESULTADO DA ANÁLISE")
        print("=" * 58)

        # Mostramos todos os diagnósticos encontrados.
        # Pode existir mais de um problema na mesma análise.
        for indice, diagnostico in enumerate(self.diagnosticos, start=1):

            print(f"\n[DIAGNÓSTICO {indice}]")
            print("-" * 58)
            print(diagnostico)

        # Agora mostramos como o sistema chegou às conclusões.
        print("\n" + "=" * 58)
        print("               EXPLICAÇÃO DO RACIOCÍNIO")
        print("=" * 58)

        print("\nVeja quais fatos e regras foram utilizados:\n")

        for passo in self.raciocinio_log:

            print(f"  > {passo}")

        print("\n" + "=" * 58)
        print("                FIM DA ANÁLISE - AUTO OFICINA")
        print("=" * 58)

        print("\nAtenção: os resultados são sugestões de triagem.")
        print("O diagnóstico definitivo depende de uma avaliação técnica.")

    # ---------------------------------------------------------
    # PARTE 6 - COLOCAR O PROGRAMA PARA RODAR
    # ---------------------------------------------------------

    def executar(self):

        # Esse método organiza a ordem das etapas:
        # 1. Perguntar os sintomas.
        # 2. Analisar as respostas.
        # 3. Mostrar o resultado.

        try:

            self.coletar_sintomas()

            self.motor_inferencia()

            self.exibir_resultado()

        except KeyboardInterrupt:

            # Acontece se o usuário apertar Ctrl + C.
            print("\n\n[!] Análise interrompida pelo usuário.")

        except Exception as erro:

            # Se acontecer algum erro inesperado,
            # mostramos a mensagem para facilitar a identificação.
            print(f"\n[ERRO] Ocorreu um problema durante a execução: {erro}")


# -------------------------------------------------------------
# INÍCIO DO PROGRAMA
# -------------------------------------------------------------

# Essa condição verifica se este arquivo foi aberto diretamente.
# Se foi, criamos o sistema e começamos a execução.

if __name__ == "__main__":

    sistema = SistemaEspecialistaOficina()

    sistema.executar()
