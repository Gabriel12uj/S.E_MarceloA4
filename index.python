class SistemaEspecialistaOficina:
    def __init__(self):
        self.fatos = {}
        self.raciocinio_log = []

    def registrar_passo(self, regra_id, descricao):
        """Registra o rastro de raciocínio para o módulo de explicação."""
        self.raciocinio_log.append(f"[Regra {regra_id}]: {descricao}")

    def validar_resposta(self, pergunta):
        """Função auxiliar para tratamento de entradas inválidas."""
        while True:
            resp = input(pergunta).strip().lower()
            if resp in ['s', 'n']:
                return resp == 's'
            print("❌ Entrada inválida! Responda apenas com 's' (sim) ou 'n' (não).")

    def coletar_sintomas(self):
        print("==================================================")
        print("  AUTO-DIAGNÓSTICO: OFICINA MECÂNICA ESPECIALIZADA")
        print("==================================================")
        print("Responda às perguntas abaixo com 's' para Sim ou 'n' para Não.\n")

        # Coleta de fatos do veículo
        self.fatos['motor_liga'] = self.validar_resposta("O motor do carro dá partida/liga? (s/n): ")

        if self.fatos['motor_liga']:
            self.fatos['barulho_freio'] = self.validar_resposta("Ouve-se chiado ou rangido ao pisar no pedal de freio? (s/n): ")
            self.fatos['luz_injecao'] = self.validar_resposta("A luz de injeção (anomalia no painel) está acesa? (s/n): ")
            self.fatos['superaquecimento'] = self.validar_resposta("O marcador de temperatura do motor está no vermelho ou subindo muito? (s/n): ")
            self.fatos['falha_aceleracao'] = self.validar_resposta("O carro engasga ou perde força ao acelerar? (s/n): ")
            self.fatos['barulho_suspensao'] = self.validar_resposta("Ouve-se barulho seco (estalos/batidas) ao passar em buracos? (s/n): ")
            self.fatos['ar_condicionado_falha'] = self.validar_resposta("O ar-condicionado parou de gelar ou exibe cheiro estranho? (s/n): ")
        else:
            self.fatos['luzes_paineis'] = self.validar_resposta("As luzes do painel e os faróis acendem quando você vira a chave? (s/n): ")
            self.fatos['barulho_teclc'] = self.validar_resposta("Ouve-se um som de 'tec-tec' rápido ao tentar dar partida? (s/n): ")

    def motor_inferencia(self):
        """Motor de inferência baseado em encadeamento para frente (regras de negócio)."""
        conclusao = None
        regras_acionadas = 0

        # Bloco de Regras para Veículos que NÃO ligam
        if not self.fatos.get('motor_liga'):
            if not self.fatos.get('luzes_paineis'):
                self.registrar_passo("R01", "Motor não liga e painel totalmente apagado.")
                self.registrar_passo("R02", "Ausência total de corrente elétrica no sistema.")
                conclusao = "Bateria totalmente descarregada, cabo principal solto ou bateria morta. Recomendação: Chupeta/Recarga ou substituição da bateria."
                regras_acionadas += 2

            elif self.fatos.get('luzes_paineis') and self.fatos.get('barulho_teclc'):
                self.registrar_passo("R03", "Painel acende, mas motor não vira e há som de 'tec-tec'.")
                self.registrar_passo("R04", "Tensão insuficiente para acionar o motor de arranque.")
                conclusao = "Motor de arranque (gatilho/escovas) com defeito ou bateria com carga insuficiente para a partida. Recomendação: Testar motor de partida e carga da bateria."
                regras_acionadas += 2

            elif self.fatos.get('luzes_paineis') and not self.fatos.get('barulho_teclc'):
                self.registrar_passo("R05", "Painel acende, sem barulho de arranque.")
                self.registrar_passo("R06", "Falha no circuito de ignição ou sensor de posição/chave.")
                conclusao = "Problema no comutador de ignição, fusível principal queimado ou defeito no motor de partida. Recomendação: Checar caixa de fusíveis e chave de ignição."
                regras_acionadas += 2

        # Bloco de Regras para Veículos que LIGAM
        else:
            if self.fatos.get('barulho_freio'):
                self.registrar_passo("R07", "Motor liga, mas há ruído anômalo no sistema de frenagem.")
                self.registrar_passo("R08", "Desgaste mecânico nas pastilhas ou discos de freio.")
                conclusao = "Pastilhas de freio gastas atingindo o limite metálico ou discos empenados. Recomendação: Substituição imediata do jogo de pastilhas e retifica/troca dos discos."
                regras_acionadas += 2

            if self.fatos.get('superaquecimento'):
                self.registrar_passo("R09", "Temperatura do motor em níveis críticos.")
                self.registrar_passo("R10", "Falha no sistema de arrefecimento (possível vazamento ou ventoinha inoperante).")
                conclusao = "Superaquecimento detectado. Possível vazamento de aditivo, válvula termostática travada ou ventoinha queimada. Recomendação: Não rodar com o veículo; verificar nível de água e sistema elétrico da ventoinha."
                regras_acionadas += 2

            if self.fatos.get('luz_injecao') and self.fatos.get('falha_aceleracao'):
                self.registrar_passo("R11", "Luz de injeção acesa combinada com perda de potência.")
                self.registrar_passo("R12", "Falha na combustão ou alimentação de combustível.")
                conclusao = "Problema no sistema de injeção eletrônica: Velas/cabos defeituosos, bicos injetores entupidos ou combustível adulterado. Recomendação: Passar scanner automotivo para leitura de códigos OBD-II."
                regras_acionadas += 2

            elif self.fatos.get('luz_injecao') and not self.fatos.get('falha_aceleracao'):
                self.registrar_passo("R13", "Luz de injeção acesa sem perda aparente de desempenho.")
                self.registrar_passo("R14", "Anomalia em sensores secundários (ex: sonda lambda ou catalisador).")
                conclusao = "Alerta na injeção sem sintomas graves imediatos. Provável falha na Sonda Lambda ou emissões de gases. Recomendação: Diagnóstico com scanner eletrônico preventivo."
                regras_acionadas += 2

            if self.fatos.get('barulho_suspensao'):
                self.registrar_passo("R15", "Ruídos estruturais ao transitar por pisos irregulares.")
                self.registrar_passo("R16", "Desgaste nos componentes elásticos ou hidráulicos da suspensão.")
                conclusao = "Desgaste em buchas de balança, amortecedores, kit de batentes ou pivôs de suspensão. Recomendação: Elevar o veículo no elevador para teste de folgas mecânicas."
                regras_acionadas += 2

            if self.fatos.get('ar_condicionado_falha'):
                self.registrar_passo("R17", "Sistema de climatização ineficiente.")
                self.registrar_passo("R18", "Possível vazamento de gás refrigerante ou filtro de cabine saturado.")
                conclusao = "Falha no ar-condicionado. Possível vazamento de gás R134a, filtro de cabine sujo ou compressor desarmado. Recomendação: Higienização do sistema e teste de pressão/carga de gás."
                regras_acionadas += 2

            # Regra padrão se o motor liga e nenhum sintoma grave foi marcado
            if regras_acionadas == 0:
                self.registrar_passo("R19", "Motor operacional e nenhum sintoma crítico crítico relatado nos subsistemas checados.")
                conclusao = "Veículo operando dentro dos parâmetros normais de triagem. Recomendação: Realizar manutenção preventiva periódica (troca de óleo e filtros)."

        # Tratamento de exceção caso nenhuma regra tenha sido acionada por falha lógica
        if not conclusao:
            self.registrar_passo("R_EX", "Exceção: O conjunto de fatos não convergiu para uma regra específica.")
            conclusao = "Não foi possível concluir um diagnóstico preciso com as informações fornecidas. Recomendação: Encaminhar o veículo para análise minuciosa na oficina física."

        return conclusao

    def executar(self):
        try:
            self.coletar_sintomas()
            resultado = self.motor_inferencia()

            print("\n================ DIAGNÓSTICO DA OFICINA ================")
            print(f"🔧 Parecer Técnico: {resultado}")
            print("\n--- Módulo de Explicação (Como o sistema chegou a esta conclusão) ---")
            print("O motor de inferência ativou as seguintes regras e fatos:")
            for passo in self.raciocinio_log:
                print(f"  • {passo}")
            print("========================================================")

        except Exception as e:
            print(f"\n[Erro Inesperado na Execução]: {e}")

if __name__ == "__main__":
    app = SistemaEspecialistaOficina()
    app.executar()
