class SistemaEspecialistaOficina:

    def __init__(self):
        # Aqui ficam as respostas do usuário e o histórico das regras utilizadas.
        self.fatos = {}
        self.raciocinio_log = []
        self.diagnosticos = []

    def registrar_passo(self, regra_id, descricao):
        """Guarda cada etapa do raciocínio para explicar o diagnóstico."""
        self.raciocinio_log.append(f"[{regra_id}] {descricao}")

    def registrar_diagnostico(self, regra_ids, descricao, resultado):
        """Registra um problema encontrado e as regras responsáveis por ele."""
        self.registrar_passo(regra_ids[0], descricao)

        if len(regra_ids) > 1:
            self.registrar_passo(regra_ids[1], "Regra de diagnóstico confirmada.")

        self.diagnosticos.append(resultado)

    def validar_resposta(self, pergunta):
        # Só aceita respostas simples para evitar erros durante a análise.
        while True:
            resposta = input(pergunta).strip().lower()

            if resposta in ("s", "n"):
                return resposta == "s"

            print("\n[!] Resposta inválida. Digite apenas S ou N.")

    def exibir_cabecalho(self):
        print("\n" + "=" * 58)
        print("             SISTEMA ESPECIALISTA")
        print("                AUTO OFICINA")
        print("=" * 58)
        print("       Diagnóstico inteligente de veículos")
        print("-" * 58)
        print("Responda às perguntas utilizando S (Sim) ou N (Não).")
        print("-" * 58)

    def coletar_sintomas(self):
        self.exibir_cabecalho()

        # Primeiro verificamos se o veículo consegue dar partida.
        self.fatos["motor_liga"] = self.validar_resposta(
            "\nO motor do carro consegue ligar? (s/n): "
        )

        if not self.fatos["motor_liga"]:
            # Se o carro não liga, investigamos a parte elétrica e a partida.
            self.fatos["luzes_paineis"] = self.validar_resposta(
                "As luzes do painel e os faróis acendem? (s/n): "
            )

            self.fatos["barulho_teclc"] = self.validar_resposta(
                "Ouve um barulho rápido de 'tec-tec' ao tentar ligar? (s/n): "
            )

        else:
            # Com o motor funcionando, verificamos os principais sistemas.
            perguntas = {
                "barulho_freio": "Ouve chiado ou rangido ao pisar no freio? (s/n): ",
                "luz_injecao": "A luz de injeção está acesa no painel? (s/n): ",
                "superaquecimento": "A temperatura do motor está muito alta? (s/n): ",
                "falha_aceleracao": "O carro engasga ou perde força ao acelerar? (s/n): ",
                "barulho_suspensao": "Ouve batidas ou estalos ao passar por buracos? (s/n): ",
                "ar_condicionado_falha": "O ar-condicionado não gela ou apresenta cheiro estranho? (s/n): "
            }

            for fato, pergunta in perguntas.items():
                self.fatos[fato] = self.validar_resposta(pergunta)

    def motor_inferencia(self):
        """Analisa os fatos coletados e aplica as regras de diagnóstico."""

        # R01 e R02: problemas elétricos ou falta de carga na bateria.
        if not self.fatos["motor_liga"]:

            if not self.fatos["luzes_paineis"]:
                self.registrar_diagnostico(
                    ("R01", "R02"),
                    "Motor não liga e o painel está completamente apagado.",
                    "Possível bateria descarregada, cabo principal solto "
                    "ou falha na alimentação elétrica. "
                    "Recomendação: verificar a bateria, os cabos e as conexões."
                )

            # R03 e R04: dificuldade para acionar o motor de partida.
            elif self.fatos["barulho_teclc"]:
                self.registrar_diagnostico(
                    ("R03", "R04"),
                    "Painel aceso, mas o veículo apresenta barulho de tec-tec.",
                    "Possível bateria com carga insuficiente ou defeito "
                    "no motor de partida. "
                    "Recomendação: testar a bateria e o sistema de partida."
                )

            # R05 e R06: falha no acionamento da partida.
            else:
                self.registrar_diagnostico(
                    ("R05", "R06"),
                    "Painel aceso, mas não há sinal sonoro ao tentar dar partida.",
                    "Possível falha no circuito de ignição, fusível, "
                    "chave ou motor de partida. "
                    "Recomendação: verificar o sistema elétrico e de ignição."
                )

        else:
            # R07 e R08: possíveis problemas no sistema de freios.
            if self.fatos["barulho_freio"]:
                self.registrar_diagnostico(
                    ("R07", "R08"),
                    "Ruídos anormais foram identificados durante a frenagem.",
                    "Possível desgaste das pastilhas ou irregularidade "
                    "nos discos de freio. "
                    "Recomendação: realizar uma inspeção no sistema de freios."
                )

            # R09 e R10: temperatura acima do normal.
            if self.fatos["superaquecimento"]:
                self.registrar_diagnostico(
                    ("R09", "R10"),
                    "O motor apresenta temperatura acima do normal.",
                    "Possível falha no sistema de arrefecimento, "
                    "vazamento de líquido, válvula termostática ou ventoinha. "
                    "Recomendação: desligar o veículo em segurança e "
                    "procurar assistência. Não abra o reservatório quente."
                )

            # R11 e R12: injeção eletrônica com perda de desempenho.
            if self.fatos["luz_injecao"] and self.fatos["falha_aceleracao"]:
                self.registrar_diagnostico(
                    ("R11", "R12"),
                    "Luz de injeção acesa junto com perda de potência.",
                    "Possível falha na injeção eletrônica, ignição "
                    "ou alimentação de combustível. "
                    "Recomendação: realizar leitura dos códigos com scanner OBD-II."
                )

            # R13 e R14: alerta de injeção sem perda de desempenho.
            elif self.fatos["luz_injecao"]:
                self.registrar_diagnostico(
                    ("R13", "R14"),
                    "Luz de injeção acesa, sem perda aparente de desempenho.",
                    "Possível anomalia em sensores, sonda lambda "
                    "ou sistema de emissões. "
                    "Recomendação: realizar diagnóstico com scanner automotivo."
                )

            # R15 e R16: possíveis falhas na suspensão.
            if self.fatos["barulho_suspensao"]:
                self.registrar_diagnostico(
                    ("R15", "R16"),
                    "Ruídos foram identificados ao passar por irregularidades.",
                    "Possível desgaste em buchas, amortecedores, pivôs "
                    "ou outros componentes da suspensão. "
                    "Recomendação: verificar folgas e componentes em uma oficina."
                )

            # R17 e R18: problemas no sistema de climatização.
            if self.fatos["ar_condicionado_falha"]:
                self.registrar_diagnostico(
                    ("R17", "R18"),
                    "O sistema de ar-condicionado apresenta funcionamento irregular.",
                    "Possível vazamento de fluido refrigerante, "
                    "filtro de cabine saturado ou falha no compressor. "
                    "Recomendação: verificar a pressão e os componentes do sistema."
                )

            # R19: nenhuma anormalidade foi identificada durante a triagem.
            if not self.diagnosticos:
                self.registrar_passo(
                    "R19",
                    "Nenhum dos sintomas investigados foi identificado."
                )

                self.diagnosticos.append(
                    "Nenhuma anormalidade foi identificada na triagem. "
                    "Recomendação: manter as revisões e a manutenção preventiva."
                )

    def exibir_resultado(self):
        print("\n" + "=" * 58)
        print("                 RESULTADO DA ANÁLISE")
        print("=" * 58)

        for indice, diagnostico in enumerate(self.diagnosticos, start=1):
            print(f"\n[DIAGNÓSTICO {indice}]")
            print("-" * 58)
            print(diagnostico)

        print("\n" + "=" * 58)
        print("             EXPLICAÇÃO DO RACIOCÍNIO")
        print("=" * 58)

        print("\nVeja quais regras foram utilizadas pelo sistema:\n")

        for passo in self.raciocinio_log:
            print(f"  > {passo}")

        print("\n" + "=" * 58)
        print("        FIM DA ANÁLISE - AUTO OFICINA")
        print("=" * 58)

        print("\nAviso: os resultados são sugestões de triagem.")
        print("O diagnóstico definitivo depende de uma avaliação técnica.")

    def executar(self):
        try:
            self.coletar_sintomas()
            self.motor_inferencia()
            self.exibir_resultado()

        except KeyboardInterrupt:
            print("\n\n[!] Análise interrompida pelo usuário.")

        except Exception as erro:
            print(f"\n[ERRO] Ocorreu um problema durante a execução: {erro}")


# Inicia o sistema quando o arquivo é executado diretamente.
if __name__ == "__main__":
    sistema = SistemaEspecialistaOficina()
    sistema.executar()

